# ----------------------------------------------------------------------------
# RestoPanel environment — copy to .env and fill in.
# ----------------------------------------------------------------------------

# PostgreSQL connection string.
# Local Docker (see docker-compose.yml):
#   postgresql://restopanel:restopanel@localhost:5432/restopanel?schema=public
# Or a free cloud Postgres (Neon: https://neon.tech) — paste its connection URL:
DATABASE_URL="postgresql://restopanel:restopanel@localhost:5432/restopanel?schema=public"

# Auth.js (NextAuth v5).
# Generate a secret with: npx auth secret   (or)  openssl rand -base64 33
AUTH_SECRET="replace-with-a-long-random-secret"

# Base URL of the app (used by Auth.js for callbacks).
AUTH_URL="http://localhost:3000"

# ---- File uploads (storage-provider agnostic) ----
# Which UploadService implementation to use: "local" (default) or "cloudinary".
UPLOAD_PROVIDER="local"
# Required only when UPLOAD_PROVIDER=cloudinary:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---- Optional, used in later phases ----
# SMS provider (Twilio) for order notifications.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
