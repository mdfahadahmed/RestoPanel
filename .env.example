# ----------------------------------------------------------------------------
# RestoPanel environment — copy to .env and fill in.
# ----------------------------------------------------------------------------

# PostgreSQL connection string.
# Local Docker (see docker-compose.yml):
#   postgresql://restopanel:restopanel@localhost:5432/restopanel?schema=public
# Or a free cloud Postgres (Neon: https://neon.tech) — paste its connection URL:
DATABASE_URL="postgresql://restopanel:restopanel@localhost:5432/restopanel?schema=public"

# Direct (non-pooled) connection, used by `prisma migrate` / `prisma db push`
# via `directUrl` in prisma/schema.prisma. On Neon this is the same URL without
# the `-pooler` part of the host. Not needed at runtime or by `prisma generate`,
# so it can be left unset on the deploy platform — only schema pushes need it.
DIRECT_URL="postgresql://restopanel:restopanel@localhost:5432/restopanel?schema=public"

# Auth.js (NextAuth v5).
# Generate a secret with: npx auth secret   (or)  openssl rand -base64 33
AUTH_SECRET="replace-with-a-long-random-secret"

# Base URL of the app (used by Auth.js for callbacks).
AUTH_URL="http://localhost:3000"

# ---- File uploads (storage-provider agnostic) ----
# Which UploadService implementation to use: "local" (default) or "cloudinary".
UPLOAD_PROVIDER="local"
# Required only when UPLOAD_PROVIDER=cloudinary:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---- Optional, used in later phases ----
# SMS provider (Twilio) for order notifications.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Email provider (Resend) — the verified sending domain lives in fromEmail.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="orders@yourdomain.com"

# Mobile push (Expo Push API). Leave unset to disable (sends are skipped).
# PUSH_PROVIDER="expo"
# EXPO_ACCESS_TOKEN=

# ---- Production / operations ----
# Platform hostname(s) so custom-domain routing knows what is "the app".
# APP_HOST="app.yourdomain.com"
# Logging verbosity: debug | info | warn | error (defaults by NODE_ENV).
# LOG_LEVEL="info"
# Error monitoring — Sentry DSN and/or a generic webhook receiver.
# SENTRY_DSN=
# ERROR_WEBHOOK_URL=
# Scheduled jobs (Vercel Cron) shared secret; required in production.
# CRON_SECRET="replace-with-a-long-random-secret"
# Daily DB backup job to trigger (managed snapshot / GitHub Action endpoint).
# BACKUP_WEBHOOK_URL=
# Override the local backup output directory for scripts/backup-db.ts.
# BACKUP_DIR="./backups"
# Build/version stamp surfaced by /api/health (Vercel sets the SHA automatically).
# APP_VERSION=

# ---- SEO / analytics ----
# Google Analytics 4 Measurement ID (public). Leave unset to disable tracking.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# Google Search Console verification token (the content of the meta-tag method).
# GOOGLE_SITE_VERIFICATION="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
