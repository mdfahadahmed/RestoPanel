// RestoPanel — multi-tenant schema.
// Tenancy model: a single shared database where every tenant-owned row carries
// a `restaurantId`. All application queries MUST be scoped by the authenticated
// user's restaurantId so one restaurant can never read another's data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) endpoint for the app
  directUrl = env("DIRECT_URL")   // direct endpoint for migrations
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------
enum Role {
  OWNER
  MANAGER
  STAFF
}

// Platform staff that operate the Super Admin panel. Kept entirely separate from
// tenant `User`s — admins do not belong to a Restaurant and authenticate via a
// dedicated session (see lib/admin/session.ts).
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

// Lifecycle of a tenant restaurant from the platform's point of view.
enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum InvoiceStatus {
  PAID
  OPEN
  VOID
  UNCOLLECTIBLE
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketAuthorType {
  ADMIN
  OWNER
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

// QR code kinds. MENU → storefront home; TABLE → storefront with a table tag;
// DYNAMIC → an editable, trackable redirect whose destination can change without
// reprinting the code.
enum QrType {
  MENU
  TABLE
  DYNAMIC
}

// Notification Center — events the platform can notify customers/owners about.
enum NotificationEvent {
  ORDER_CONFIRMED
  ORDER_PREPARING
  ORDER_READY
  ORDER_DELIVERED
  RESERVATION
  RESERVATION_CONFIRMED
  RESERVATION_REJECTED
  RESERVATION_RESCHEDULED
  WELCOME
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED // no recipient / channel disabled / provider not configured
}

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  SEATED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum ReservationSource {
  WEBSITE
  DASHBOARD
  PHONE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------
model Restaurant {
  id        String   @id @default(cuid())
  slug      String   @unique // used for the customer site URL: /r/<slug>
  name      String
  ownerName String

  // Contact / settings
  email          String?
  phone          String?
  whatsapp       String?
  website        String?
  logoUrl        String?
  logoKey        String?
  coverImageUrl  String?
  coverKey       String?
  address        String? // composed single-line address (kept for the storefront)
  street         String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  openingHours   Json? // { mon: { open, close } | null, ... }
  holidays       Json? // [{ date: "YYYY-MM-DD", name }]
  temporaryClosure Json? // { enabled, message, until }

  deliveryEnabled Boolean @default(true)
  deliveryRadius  Int?    // in km
  minimumOrder    Decimal @default(0) @db.Decimal(10, 2)
  pickupEnabled   Boolean @default(true)
  dineInEnabled   Boolean @default(true)
  deliveryFee    Decimal @default(0) @db.Decimal(10, 2)
  taxName        String  @default("Tax")
  taxRate        Decimal @default(0) @db.Decimal(5, 2) // percentage applied to order subtotal

  currency       String  @default("GBP")
  currencySymbol String  @default("£")
  timezone       String  @default("Europe/London")

  latitude       Float?
  longitude      Float?
  description      String?
  shortDescription String?

  facebookUrl  String?
  instagramUrl String?
  tiktokUrl    String?
  twitterUrl   String?

  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  ogImageKey      String?

  primaryColor   String  @default("#E8C372")
  secondaryColor String  @default("#8B5CF6")
  themePreset    String  @default("midnight")

  // Platform administration state (managed only from the Super Admin panel).
  status            RestaurantStatus @default(ACTIVE)
  suspendedAt       DateTime?
  suspendedReason   String?
  platformDeletedAt DateTime? // soft-delete from the platform; row hidden, kept for audit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  categories   Category[]
  products     Product[]
  customers    Customer[]
  orders       Order[]
  reservations Reservation[]
  reviews      Review[]
  coupons      Coupon[]
  subscription Subscription?
  invoices     Invoice[]
  tickets      SupportTicket[]
  qrCodes      QrCode[]
  notificationTemplates NotificationTemplate[]
  notificationLogs      NotificationLog[]
  apiKeys               ApiKey[]
  tables                RestaurantTable[]
  reservationSetting    ReservationSetting?

  @@index([status])
  @@index([platformDeletedAt])
}

// ---------------------------------------------------------------------------
// Auth / staff
// ---------------------------------------------------------------------------
model User {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name         String
  email        String @unique
  passwordHash String
  role         Role   @default(OWNER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

// ---------------------------------------------------------------------------
// Menu
// ---------------------------------------------------------------------------
model Category {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name     String
  slug     String
  position Int     @default(0)
  isActive Boolean @default(true)

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([restaurantId, slug])
  @@index([restaurantId])
}

model Product {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name             String
  slug             String
  description      String?
  shortDescription String?

  // Images: ordered array of { url, key }. The first entry is the thumbnail.
  images       Json     @default("[]")

  price        Decimal  @db.Decimal(10, 2)
  comparePrice Decimal? @db.Decimal(10, 2) // optional "was" price shown struck-through
  costPrice    Decimal? @db.Decimal(10, 2) // internal cost, used for margin (never shown to customers)
  discount     Decimal  @default(0) @db.Decimal(10, 2) // percentage off (0–100)

  sku          String?
  barcode      String?
  calories     Int?
  stockQuantity Int?
  stockStatus  StockStatus @default(IN_STOCK)

  status       ProductStatus @default(ACTIVE)
  isAvailable  Boolean  @default(true)
  featured     Boolean  @default(false)
  bestSeller   Boolean  @default(false)

  prepTimeMins Int?
  ingredients  String[]
  extras       Json? // [{ name, price, isActive }]
  variants     Json? // [{ name, priceAdjustment, stock, sku }]

  // Soft delete — rows are hidden, never physically removed by the UI.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@index([restaurantId, categoryId])
  @@index([restaurantId, deletedAt])
  @@index([restaurantId, status])
}

// ---------------------------------------------------------------------------
// Customers & orders
// ---------------------------------------------------------------------------
model Customer {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name    String?
  phone   String
  email   String?
  address String?

  tags   String[]       @default([])
  status CustomerStatus @default(ACTIVE)

  orders    Order[]
  notes     CustomerNote[]
  reviews   Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@index([restaurantId, status])
}

// Timestamped CRM notes attached to a customer (add / edit / delete).
model CustomerNote {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurantId String // denormalised for direct tenant-scoped access

  body String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([restaurantId])
}

model Order {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  orderNumber String
  type        OrderType   @default(DELIVERY)
  status      OrderStatus @default(PENDING)

  // Customer snapshot — denormalised so the order is self-contained even if the
  // customer record is later edited or removed.
  customerName  String?
  customerPhone String?
  customerEmail String?
  address       String?

  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(UNPAID)

  // Money — all Decimal(10,2). total = subtotal - discountAmount + taxAmount + deliveryFee.
  subtotal       Decimal @default(0) @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  deliveryFee    Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  couponCode      String? // snapshot of an applied coupon code

  notes           String? // customer-facing note (delivery instructions, etc.)
  restaurantNotes String? // internal staff note, never shown to the customer

  items     OrderItem[]
  events    OrderEvent[]
  review    Review?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, paymentStatus])
  @@index([restaurantId, customerId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  nameSnapshot String
  unitPrice    Decimal @db.Decimal(10, 2) // final per-unit price incl. variant + extras
  quantity     Int     @default(1)
  lineTotal    Decimal @db.Decimal(10, 2) // unitPrice * quantity
  options      Json? // { variant?: { name, priceAdjustment }, extras: [{ name, price }] }

  @@index([orderId])
}

// Append-only status/event log powering the order timeline.
model OrderEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status OrderStatus
  note   String?

  createdAt DateTime @default(now())

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Storefront: reservations & reviews
// ---------------------------------------------------------------------------
model Reservation {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Optional assigned table (auto-assigned on booking when tables exist).
  tableId String?
  table   RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  name      String
  phone     String
  email     String?
  date      DateTime // requested date + time (start)
  durationMins Int    @default(90)
  partySize Int      @default(2)
  notes     String?
  status    ReservationStatus @default(PENDING)
  source    ReservationSource @default(WEBSITE)
  reference String? // short human code for lookups (unique per restaurant)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, reference])
  @@index([restaurantId, date])
  @@index([restaurantId, status])
  @@index([tableId, date])
}

// ---------------------------------------------------------------------------
// Reservation tables & settings
// ---------------------------------------------------------------------------
model RestaurantTable {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name     String // e.g. "T1", "Patio 3"
  capacity Int    @default(2)
  location String? // "Indoor", "Patio", "Bar"
  isActive Boolean @default(true)
  position Int     @default(0)

  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

// Per-restaurant reservation configuration (a single row per restaurant).
model ReservationSetting {
  id           String @id @default(cuid())
  restaurantId String @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  enabled         Boolean @default(true)
  slotMinutes     Int     @default(30) // granularity of bookable times
  durationMins    Int     @default(90) // how long a table is held
  minPartySize    Int     @default(1)
  maxPartySize    Int     @default(12)
  capacityPerSlot Int? // covers per slot when NO tables are defined; null = unlimited
  leadTimeHours   Int     @default(2) // minimum notice
  horizonDays     Int     @default(60) // how far ahead bookings are allowed
  requireApproval Boolean @default(true)

  // Per-weekday open windows: { mon: [{open:"17:00",close:"22:00"}], ... }
  openingHours Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId      String?  @unique
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  customerName String
  rating       Int // 1..5
  comment      String?
  reply        String? // owner's response
  repliedAt    DateTime?
  isPublished  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, isPublished])
  @@index([restaurantId, rating])
  @@index([restaurantId, createdAt])
}

model Coupon {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  code         String // stored uppercase, unique per restaurant
  type         CouponType @default(PERCENTAGE)
  value        Decimal    @db.Decimal(10, 2) // percent (0–100) or fixed amount
  minimumOrder Decimal    @default(0) @db.Decimal(10, 2)
  usageLimit   Int? // null = unlimited
  usedCount    Int        @default(0)
  startsAt     DateTime?
  endsAt       DateTime?
  isActive     Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, code])
  @@index([restaurantId])
}

// ---------------------------------------------------------------------------
// QR menu codes
// ---------------------------------------------------------------------------
model QrCode {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  label String
  type  QrType @default(MENU)

  // Short public slug used by the /q/<code> redirect. Always set so any code can
  // be made trackable; it is what a DYNAMIC code encodes.
  code String @unique

  tableNumber Int? // TABLE only
  // DYNAMIC only — the storefront path it currently resolves to (editable).
  // Null falls back to the restaurant's storefront home.
  targetPath  String?

  // When true the printed QR encodes /q/<code> (a redirect we can re-point and
  // that records scans). When false it encodes the absolute destination directly.
  isDynamic   Boolean @default(false)
  logoEnabled Boolean @default(true)
  isActive    Boolean @default(true)

  scanCount     Int       @default(0)
  lastScannedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

// ---------------------------------------------------------------------------
// Notification Center
// ---------------------------------------------------------------------------

// A per-restaurant override of a default notification template. Body/subject may
// contain {{placeholders}} interpolated at send time. Absence of a row means the
// built-in default template (lib/notifications/templates.ts) is used.
model NotificationTemplate {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  event   NotificationEvent
  channel NotificationChannel

  subject  String? // email only
  body     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, event, channel])
  @@index([restaurantId])
}

// Append-only history of every notification the platform attempted to send.
model NotificationLog {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  event    NotificationEvent
  channel  NotificationChannel
  provider String // "resend" | "twilio" | "log"

  recipient String
  subject   String?
  body      String

  status            NotificationStatus @default(QUEUED)
  error             String?
  providerMessageId String?

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, event])
  @@index([restaurantId, status])
}

// ---------------------------------------------------------------------------
// Public REST API
// ---------------------------------------------------------------------------

// A restaurant's API credential. Only the SHA-256 hash of the secret is stored;
// the plaintext key is shown to the owner exactly once at creation time.
model ApiKey {
  id           String @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name      String
  prefix    String // public, shown in the UI e.g. "rp_live_ab12cd"
  hashedKey String @unique // sha256(plaintext)
  last4     String

  scopes          String[] @default([])
  rateLimitPerMin Int      @default(60)

  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  windows ApiRateWindow[]

  @@index([restaurantId])
}

// Fixed-window rate-limit counter (one row per key per minute). DB-backed so it
// needs no external store; old windows are pruned opportunistically.
model ApiRateWindow {
  id       String @id @default(cuid())
  apiKeyId String
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  windowStart Int // epoch-minute bucket (floor(epochMs / 60000))
  count       Int @default(0)

  @@unique([apiKeyId, windowStart])
  @@index([apiKeyId])
}

// ===========================================================================
// PLATFORM / SUPER ADMIN
// These models are owned by the platform operator, not by any tenant. They are
// only ever read/written from the /admin area behind a SUPER_ADMIN session.
// ===========================================================================

// Platform operators. Completely separate from tenant `User`s.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(SUPER_ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Subscription plans / pricing tiers. Drive both billing and the public Pricing
// page (CMS). `features` is an ordered string array of bullet points.
model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  priceMonthly Decimal  @default(0) @db.Decimal(10, 2)
  priceYearly  Decimal  @default(0) @db.Decimal(10, 2)
  currency     String   @default("GBP")
  features     String[] @default([])

  // Usage limits — null means unlimited.
  maxProducts Int?
  maxOrders   Int? // per calendar month
  maxStaff    Int?

  // Feature restrictions (capabilities unlocked by this plan).
  analytics        Boolean @default(false)
  smsNotifications Boolean @default(false)
  coupons          Boolean @default(false)
  customDomain     Boolean @default(false)
  prioritySupport  Boolean @default(false)

  trialDays  Int     @default(14)
  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)
  // Rank used to decide upgrade vs downgrade (0 = lowest tier).
  position   Int     @default(0)

  // Stripe linkage (set once products/prices are created in Stripe).
  stripeProductId      String?
  stripePriceMonthlyId String?
  stripePriceYearlyId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

// One subscription per restaurant (the tenant's place on a Plan).
model Subscription {
  id           String @id @default(cuid())
  restaurantId String @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  planId       String
  plan         Plan   @relation(fields: [planId], references: [id])

  status       SubscriptionStatus @default(TRIALING)
  billingCycle BillingCycle       @default(MONTHLY)
  amount       Decimal            @db.Decimal(10, 2) // charged per cycle, snapshot of plan price

  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  canceledAt         DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  // Scheduled downgrade: applied at the end of the current period.
  pendingPlanId       String?
  pendingBillingCycle BillingCycle?

  stripeCustomerId     String?
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([stripeCustomerId])
}

model Invoice {
  id             String        @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  number      String        @unique
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("GBP")
  status      InvoiceStatus @default(OPEN)
  description String?

  periodStart DateTime?
  periodEnd   DateTime?
  issuedAt    DateTime  @default(now())
  paidAt      DateTime?

  // Stripe linkage + customer-facing document links.
  stripeInvoiceId String? @unique
  hostedUrl       String?
  pdfUrl          String?

  createdAt DateTime @default(now())

  @@index([restaurantId])
  @@index([status])
  @@index([issuedAt])
}

// Idempotency log for Stripe webhooks — guarantees an event is processed once.
model ProcessedWebhook {
  id          String   @id // Stripe event id (evt_...)
  type        String
  processedAt DateTime @default(now())
}

// Support tickets. May be raised by a tenant (restaurantId set) or unattached.
model SupportTicket {
  id           String         @id @default(cuid())
  restaurantId String?
  restaurant   Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  subject      String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(NORMAL)

  // Denormalised requester snapshot so the ticket is self-contained.
  requesterName  String
  requesterEmail String

  lastMessageAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TicketMessage[]

  @@index([status])
  @@index([priority])
  @@index([restaurantId])
}

model TicketMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorType TicketAuthorType
  authorName String
  body       String

  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// CMS — public marketing content edited from the admin panel.
// ---------------------------------------------------------------------------

// Generic key→content document for singleton pages (landing, pricing, contact).
// `content` holds a page-specific JSON blob (hero copy, sections, etc.).
model CmsPage {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "landing", "pricing", "contact"
  title     String
  content   Json     @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model FaqItem {
  id          String  @id @default(cuid())
  question    String
  answer      String
  category    String  @default("General")
  position    Int     @default(0)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
}

model BlogPost {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String?
  content     String     @default("")
  coverUrl    String?
  author      String     @default("RestoPanel")
  status      BlogStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Inbound messages from the public landing contact form.
model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  restaurant String?
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Platform settings — a single global row (integrations + branding).
// Secrets live here rather than env so they can be edited from the panel.
// ---------------------------------------------------------------------------
model PlatformSettings {
  id String @id @default("singleton") // enforce a single row

  // Branding
  platformName String  @default("RestoPanel")
  logoUrl      String?
  faviconUrl   String?
  supportEmail String?

  // Integration config blobs: { ...keys, enabled }. Validated at the edge.
  smtp       Json @default("{}")
  cloudinary Json @default("{}")
  stripe     Json @default("{}")
  sms        Json @default("{}") // Twilio (SMS notifications)
  resend     Json @default("{}") // Resend (email notifications)
  googleMaps Json @default("{}")

  updatedAt DateTime @updatedAt
}
